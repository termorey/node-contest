{
  "name": "@termorey/node-contest",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "Instance for creation Contest events",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "format:apply": "prettier **/*.{ts,tsx,js,jsx} --write"
  },
  "keywords": [],
  "author": "termorey<https://github.com/termorey>",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.6.1",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "canvas": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/termorey/node-contest.git"
  },
  "bugs": {
    "url": "https://github.com/termorey/node-contest/issues"
  },
  "homepage": "https://github.com/termorey/node-contest#readme",
  "main": "./dist/index.js",
  "files": [
    "./dist"
  ],
  "types": "./dist/export.d.ts",
  "exports": {
    ".": {
      "types": "./dist/export.d.ts",
      "import": "./dist/index.js"
    }
  }
}
